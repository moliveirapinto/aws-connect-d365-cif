# Direct Line secret from the Azure Bot's Direct Line channel (Azure portal ->
# your bot -> Channels -> Direct Line -> Secret keys). This is what lets the
# ingestor open conversations and stream transcript turns into Omnichannel.
DIRECTLINE_SECRET=

# Direct Line base URL. Leave as-is for the public Bot Framework endpoint.
DIRECTLINE_DOMAIN=https://directline.botframework.com/v3/directline

# Logical id of the Custom Messaging channel in Omnichannel (echoed in
# channelData for attribution / the relay bot).
OC_CHANNEL_ID=
